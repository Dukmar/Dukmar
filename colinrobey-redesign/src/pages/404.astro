---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Colin Robey" noindex description="That page isn’t here.">
  <main id="main">
    <section class="page-hero" style="padding-block:clamp(4rem,3rem + 5vw,8rem)"><div class="wrap">
      <p class="hand" style="font-size:2rem; margin:0 0 .5rem">I’d circle this in red pen.</p>
      <h1>That page isn’t here.</h1>
      <p class="lead">A broken link is exactly the kind of thing the free scorecard catches. Try the homepage, or tell me where you were headed.</p>
      <div class="hero-actions"><a class="btn btn-pen" href="/">Back to the homepage</a><a class="btn btn-ghost" href="/contact/">Contact me</a></div>
    </div></section>
  </main>
</Base>
