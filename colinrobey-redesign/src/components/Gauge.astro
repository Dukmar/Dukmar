---
// A PageSpeed-style ring. Renders its final value in the HTML (complete at rest); the
// sitewide script replays the fill when it scrolls into view.
interface Props { value: number; label: string; variant?: 'before' | 'after'; onPaper?: boolean }
const { value, label, variant = 'after', onPaper = false } = Astro.props;
const C = 2 * Math.PI * 52;
const dash = (value / 100) * C;
---
<figure class:list={['gauge', `gauge--${variant}`, { 'on-paper': onPaper }]} data-gauge={value}>
  <svg viewBox="0 0 132 132" role="img" aria-label={`${label}: ${value} out of 100`}>
    <circle class="track" cx="66" cy="66" r="52" />
    <circle class="val" cx="66" cy="66" r="52" stroke-dasharray={`${dash.toFixed(1)} ${C.toFixed(1)}`} data-c={C.toFixed(1)} />
    <text x="66" y="78" text-anchor="middle">{value}</text>
  </svg>
  <figcaption>{label}</figcaption>
</figure>
